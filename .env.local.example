# InsForge
NEXT_PUBLIC_INSFORGE_URL=https://your-app.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key-here
# Override in production: NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog (Analytics)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-public-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=your-posthog-personal-api-key
POSTHOG_PROJECT_ID=your-posthog-project-id

# Groq (Free LLM API) — https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here

# Adzuna (Job Search)
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
